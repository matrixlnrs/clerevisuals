# Netlify reads this file from the published folder — which means it works for
# a drag-and-drop deploy of dist/ just as well as for a build from git.
# netlify.toml, at the project root, would only be read in the git case; the
# headers live here instead so there is one source of truth and no way to
# deploy without them.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # style-src needs 'unsafe-inline': React writes inline style attributes
  # throughout, and the stylesheet itself is inlined into the HTML. script-src
  # does not, which is the one that matters — keep it that way by never
  # introducing an inline event handler. Fonts are self-hosted, so no
  # third-party origin appears here at all.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://api.web3forms.com

# Vite fingerprints everything in /assets/, so these can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Same for the fonts: the filename encodes family, weight and subset, and a
# different font would be a different file.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Photo filenames are stable — replacing a photo reuses its URL — so this is a
# long cache but deliberately not immutable: a swapped photo should reach
# visitors within the month rather than never.
/images/*
  Cache-Control: public, max-age=2592000

/*.html
  Cache-Control: public, max-age=0, must-revalidate
